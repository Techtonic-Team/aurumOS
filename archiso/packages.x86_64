# Base system and hardware support
base
linux-zen
# Keep firmware focused on the hardware commonly used by the live image.
# The linux-firmware meta package pulls every vendor firmware collection and
# exceeds the ISO size budget by itself.
linux-firmware-intel
linux-firmware-realtek
amd-ucode
intel-ucode
sof-firmware
mkinitcpio-archiso

# BIOS bootloader required by the syslinux boot mode
syslinux

# Live installer and essential storage support
alci-calamares
aurum-calamares-config
archinstall
btrfs-progs
cryptsetup
dosfstools
e2fsprogs
efibootmgr
exfatprogs
lvm2
ntfs-3g
os-prober
parted

# Networking
networkmanager
network-manager-applet
iwd
wireless-regdb

# COSMIC desktop (Rust/Wayland)
sddm
cosmic-session
cosmic-terminal
cosmic-files
cosmic-settings
xdg-desktop-portal-cosmic

# Audio and everyday live-session utilities
pipewire
pipewire-pulse
wireplumber
alsa-utils
bash-completion
less
nano
sudo
zsh

# aurumOS branding
aurum-artwork
aurum-backgrounds
